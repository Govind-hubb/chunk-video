# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/video_streaming_db

# Redis Connection (Used for BullMQ job queue & PubSub)
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage Configuration ('local' for zero-cost dev without AWS, or 's3' for AWS S3 / Cloudflare R2)
STORAGE_DRIVER=local

# AWS S3 Settings (Required only if STORAGE_DRIVER=s3)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=my-video-stream-bucket
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# JWT Secret
JWT_SECRET=super_secret_jwt_key_change_in_production
